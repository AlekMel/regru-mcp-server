# REG.RU API credentials
# Sandbox: username=test, password=test (syntax validation only, no real changes)
REGRU_USERNAME=test
REGRU_PASSWORD=test

# Optional: RSA private key (PEM contents or path to .pem file) instead of password
# REGRU_PRIVATE_KEY=/path/to/private_key.pem

# Optional: Override API base URL
# REGRU_BASE_URL=https://api.reg.ru/api/regru2

# --- MCP transport ---
# Default: stdio (local Cursor / Claude Desktop). Leave unset for local use.
# MCP_TRANSPORT=stdio

# HTTP Streamable mode for remote deploy (Coolify / Docker). Requires MCP_AUTH_TOKEN.
# MCP_TRANSPORT=http

# Mandatory when MCP_TRANSPORT=http — long random secret (e.g. openssl rand -hex 32).
# Server refuses to start HTTP without this. Never commit the real value.
# MCP_AUTH_TOKEN=

# Optional comma-separated client IP / CIDR allowlist for /mcp (403 if not matched).
# Requires reverse proxy to set X-Forwarded-For; app uses trust proxy.
# Example: MCP_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
# MCP_ALLOWED_IPS=

# HTTP bind (containers: 0.0.0.0). Defaults shown.
# HOST=0.0.0.0
# PORT=3000
